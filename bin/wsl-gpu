#!/bin/sh
# wsl-gpu - give containers the WSL2 NVIDIA GPU through CDI (Container Device
# Interface), with no nvidia-container-toolkit, no glibc and no systemd.
# Built for Alpine Linux on WSL2; works on any distro with a POSIX shell.
#
# SPDX-License-Identifier: MIT
# https://github.com/DivitGopi/wsl-gpu-cdi

set -eu

VERSION="0.1.0"
PROG="${0##*/}"

# Everything below can be overridden from the environment (used by the tests).
DXG="${WSL_GPU_DXG:-/dev/dxg}"
LIB_DIR="${WSL_GPU_LIB_DIR:-/usr/lib/wsl/lib}"
DRIVERS_DIR="${WSL_GPU_DRIVERS_DIR:-/usr/lib/wsl/drivers}"
CDI_DIR="${WSL_GPU_CDI_DIR:-/var/run/cdi}"
CDI_FILE="${CDI_DIR}/nvidia-wsl.yaml"
TEST_IMAGE="${WSL_GPU_TEST_IMAGE:-ubuntu:24.04}"
# Containers find libcuda through LD_LIBRARY_PATH. The NVIDIA paths are kept so
# images built for nvidia-container-toolkit (nvidia/cuda, pytorch, ...) still work.
LD_PATH="${WSL_GPU_LD_LIBRARY_PATH:-/usr/lib/wsl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64}"

# Fixed paths inside the container: libcuda in WSL expects these locations.
CTR_DXG="/dev/dxg"
CTR_LIB_DIR="/usr/lib/wsl/lib"
CTR_DRIVERS_DIR="/usr/lib/wsl/drivers"

KIND="nvidia.com/gpu"
CDI_VERSION="0.6.0"
QUIET=0

# --- output helpers ---------------------------------------------------------

say()  { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"; }
warn() { printf '%s: warning: %s\n' "$PROG" "$*" >&2; }
die()  { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 1; }

usage() {
	cat <<EOF
$PROG $VERSION - use the WSL2 NVIDIA GPU in containers, without nvidia-container-toolkit

Usage: $PROG <command> [options]

Commands:
  generate [--stdout | --output FILE] [--if-present] [--quiet]
                 Detect the GPU and write the CDI spec (default: $CDI_FILE).
                 --if-present: exit 0 without writing when no NVIDIA GPU is found.
  doctor [--run-test]
                 Check every piece of the setup. --run-test also runs nvidia-smi
                 in a container ($TEST_IMAGE).
  smi [ARGS...]  Run nvidia-smi. On the host if a glibc loader is present
                 (apk add gcompat), otherwise inside a container.
  remove         Delete the generated CDI spec.
  version        Print the version.
  help           Show this help.

Then run containers with:  docker run --rm --device $KIND=all IMAGE ...
EOF
}

# --- detection --------------------------------------------------------------

have_dxg() {
	[ -c "$DXG" ] && return 0
	# Tests use a regular file in place of the character device.
	[ "${WSL_GPU_ALLOW_FAKE_DXG:-0}" = 1 ] && [ -e "$DXG" ]
}

have_libs() {
	[ -e "$LIB_DIR/libcuda.so.1" ] && [ -e "$LIB_DIR/libdxcore.so" ]
}

# Print every driver-store folder that holds the NVIDIA WSL user-mode driver.
# The folder name carries a hash that changes on every Windows driver update.
nvidia_driver_dirs() {
	[ -d "$DRIVERS_DIR" ] || return 0
	for d in "$DRIVERS_DIR"/*/; do
		[ -d "$d" ] || continue
		if [ -e "${d}libcuda.so.1.1" ] || [ -e "${d}libnvidia-ml.so.1" ]; then
			d="${d%/}"
			printf '%s\n' "$d"
		fi
	done
}

is_wsl2() {
	[ -n "${WSL_DISTRO_NAME:-}" ] && return 0
	grep -qi 'microsoft-standard-wsl2' /proc/sys/kernel/osrelease 2>/dev/null
}

# YAML double-quoted scalar. Paths with quotes or backslashes are refused.
yq_str() {
	case "$1" in
		*\"* | *\\*) die "unsupported character in path: $1" ;;
	esac
	printf '"%s"' "$1"
}

# --- generate ---------------------------------------------------------------

emit_spec() {
	drivers="$1"
	cat <<EOF
# Generated by wsl-gpu $VERSION on $(date -u '+%Y-%m-%dT%H:%M:%SZ').
# Do not edit: run \`wsl-gpu generate\` again after a Windows driver update.
cdiVersion: "$CDI_VERSION"
kind: $KIND
devices:
  - name: all
    containerEdits:
      deviceNodes:
        - path: $CTR_DXG
EOF
	if [ "$DXG" != "$CTR_DXG" ]; then
		printf '          hostPath: %s\n' "$(yq_str "$DXG")"
	fi
	cat <<EOF
containerEdits:
  env:
    - $(yq_str "LD_LIBRARY_PATH=$LD_PATH")
  mounts:
    - hostPath: $(yq_str "$LIB_DIR")
      containerPath: $CTR_LIB_DIR
      options: ["ro", "nosuid", "nodev", "rbind", "rprivate"]
EOF
	printf '%s\n' "$drivers" | while IFS= read -r d; do
		[ -n "$d" ] || continue
		cat <<EOF
    - hostPath: $(yq_str "$d")
      containerPath: $(yq_str "$CTR_DRIVERS_DIR/${d##*/}")
      options: ["ro", "nosuid", "nodev", "rbind", "rprivate"]
EOF
	done
}

cmd_generate() {
	out="$CDI_FILE"
	to_stdout=0
	if_present=0
	while [ $# -gt 0 ]; do
		case "$1" in
			--stdout) to_stdout=1 ;;
			--output | -o)
				[ $# -ge 2 ] || die "--output needs a file"
				out="$2"
				shift
				;;
			--if-present) if_present=1 ;;
			--quiet | -q) QUIET=1 ;;
			*) die "generate: unknown option: $1" ;;
		esac
		shift
	done

	missing=""
	have_dxg || missing="$DXG not found (is this WSL2 with a GPU driver on Windows?)"
	if [ -z "$missing" ] && ! have_libs; then
		missing="WSL GPU libraries not found in $LIB_DIR"
	fi
	drivers=""
	if [ -z "$missing" ]; then
		drivers="$(nvidia_driver_dirs)"
		[ -n "$drivers" ] || missing="no NVIDIA driver in $DRIVERS_DIR (no NVIDIA GPU, or the Windows driver is too old)"
	fi
	if [ -n "$missing" ]; then
		if [ "$if_present" -eq 1 ]; then
			say "$PROG: $missing; nothing to do"
			exit 0
		fi
		die "$missing"
	fi

	if [ "$to_stdout" -eq 1 ]; then
		emit_spec "$drivers"
		return 0
	fi

	dir="$(dirname "$out")"
	mkdir -p "$dir" || die "cannot create $dir (try running as root)"
	tmp="$out.tmp.$$"
	trap 'rm -f "$tmp"' EXIT INT TERM
	emit_spec "$drivers" >"$tmp" || die "cannot write $tmp (try running as root)"
	chmod 0644 "$tmp"
	mv -f "$tmp" "$out"
	trap - EXIT INT TERM
	say "$PROG: wrote $out"
	printf '%s\n' "$drivers" | while IFS= read -r d; do say "  driver: ${d##*/}"; done
	say "  use it: docker run --rm --device $KIND=all IMAGE ..."
}

# --- doctor -----------------------------------------------------------------

FAILS=0
ok()   { printf '  [ ok ] %s\n' "$*"; }
bad()  { printf '  [FAIL] %s\n' "$*"; FAILS=$((FAILS + 1)); }
info() { printf '  [info] %s\n' "$*"; }
note() { printf '  [warn] %s\n' "$*"; }

docker_ready() {
	command -v docker >/dev/null 2>&1 || return 1
	i=0
	while [ $i -lt 15 ]; do
		docker info >/dev/null 2>&1 && return 0
		i=$((i + 1))
		sleep 1
	done
	return 1
}

host_loader() {
	for l in /lib64/ld-linux-x86-64.so.2 /lib/ld-linux-x86-64.so.2; do
		[ -e "$l" ] && return 0
	done
	return 1
}

cmd_doctor() {
	run_test=0
	for a in "$@"; do
		case "$a" in
			--run-test) run_test=1 ;;
			*) die "doctor: unknown option: $a" ;;
		esac
	done

	echo "$PROG $VERSION doctor"
	echo "System"
	if is_wsl2; then ok "running on WSL2 (kernel $(uname -r))"; else bad "not running on WSL2"; fi
	if [ -r /etc/alpine-release ]; then info "Alpine $(cat /etc/alpine-release)"; fi

	echo "GPU"
	if have_dxg; then ok "$DXG present"; else bad "$DXG missing: install a WSL-capable GPU driver on Windows"; fi
	if have_libs; then ok "WSL GPU libraries in $LIB_DIR"; else bad "libcuda.so.1 / libdxcore.so missing in $LIB_DIR"; fi
	drivers="$(nvidia_driver_dirs)"
	if [ -n "$drivers" ]; then
		printf '%s\n' "$drivers" | while IFS= read -r d; do ok "NVIDIA driver folder ${d##*/}"; done
		n="$(printf '%s\n' "$drivers" | wc -l | tr -d ' ')"
		[ "$n" -le 1 ] || note "$n NVIDIA driver folders found; all are mounted"
	else
		bad "no NVIDIA driver folder in $DRIVERS_DIR"
	fi
	if host_loader; then
		v="$(LD_LIBRARY_PATH="$LIB_DIR" "$LIB_DIR/nvidia-smi" --query-gpu=name,driver_version,memory.total --format=csv,noheader 2>/dev/null | head -n1 || true)"
		if [ -n "$v" ]; then ok "nvidia-smi on host: $v"; else note "glibc loader present but nvidia-smi failed on the host"; fi
	else
		info "host nvidia-smi needs a glibc loader (optional: apk add gcompat)"
	fi

	echo "CDI spec"
	if [ -s "$CDI_FILE" ]; then
		ok "$CDI_FILE exists"
		if [ -n "$drivers" ]; then
			printf '%s\n' "$drivers" | while IFS= read -r d; do
				grep -qF "$d" "$CDI_FILE" || { printf '  [FAIL] spec does not mount %s: run "%s generate"\n' "${d##*/}" "$PROG"; exit 1; }
			done || FAILS=$((FAILS + 1))
		fi
	else
		bad "$CDI_FILE missing: run \`$PROG generate\` as root"
	fi
	for f in /etc/cdi/*.yaml /etc/cdi/*.json /var/run/cdi/*.yaml /var/run/cdi/*.json; do
		[ -e "$f" ] && [ "$f" != "$CDI_FILE" ] || continue
		if grep -q "^kind: *\"\{0,1\}$KIND" "$f" 2>/dev/null; then
			note "$f also defines $KIND; Docker refuses duplicate device names"
		fi
	done

	echo "Docker"
	if ! command -v docker >/dev/null 2>&1; then
		info "docker not installed"
	elif ! docker_ready; then
		bad "docker daemon not reachable"
	else
		ok "docker $(docker version --format '{{.Server.Version}}' 2>/dev/null)"
		dirs="$(docker info --format '{{json .CDISpecDirs}}' 2>/dev/null || true)"
		# /var/run is usually a link to /run, so compare real paths.
		real_cdi="$(cd "$CDI_DIR" 2>/dev/null && pwd -P || printf '%s' "$CDI_DIR")"
		case "$dirs" in
			"" | "null" | "[]") bad "CDI is off: add {\"features\":{\"cdi\":true}} to /etc/docker/daemon.json and restart docker" ;;
			*"\"$CDI_DIR\""* | *"\"$real_cdi\""*) ok "CDI enabled, reads $CDI_DIR" ;;
			*) bad "docker reads CDI specs from $dirs, not $CDI_DIR" ;;
		esac
		if [ "$run_test" -eq 1 ]; then
			if out="$(docker run --rm --device "$KIND=all" "$TEST_IMAGE" "$CTR_LIB_DIR/nvidia-smi" -L 2>&1)"; then
				ok "container test: $(printf '%s' "$out" | head -n1)"
			else
				bad "container test failed: $(printf '%s' "$out" | tail -n1)"
			fi
		fi
	fi

	echo
	if [ "$FAILS" -eq 0 ]; then echo "All checks passed."; else echo "$FAILS check(s) failed."; fi
	[ "$FAILS" -eq 0 ]
}

# --- smi --------------------------------------------------------------------

cmd_smi() {
	if host_loader && [ -x "$LIB_DIR/nvidia-smi" ]; then
		LD_LIBRARY_PATH="$LIB_DIR" exec "$LIB_DIR/nvidia-smi" "$@"
	fi
	docker_ready || die "no glibc loader on the host (apk add gcompat) and docker is not reachable"
	exec docker run --rm --device "$KIND=all" "$TEST_IMAGE" "$CTR_LIB_DIR/nvidia-smi" "$@"
}

cmd_remove() {
	if [ -e "$CDI_FILE" ]; then
		rm -f "$CDI_FILE" || die "cannot remove $CDI_FILE (try running as root)"
		say "$PROG: removed $CDI_FILE"
	else
		say "$PROG: nothing to remove"
	fi
}

# --- main -------------------------------------------------------------------

[ $# -gt 0 ] || { usage; exit 0; }
cmd="$1"
shift
case "$cmd" in
	generate) cmd_generate "$@" ;;
	doctor) cmd_doctor "$@" ;;
	smi) cmd_smi "$@" ;;
	remove) cmd_remove ;;
	version | --version | -V) echo "$PROG $VERSION" ;;
	help | --help | -h) usage ;;
	*)
		usage >&2
		exit 2
		;;
esac
