# Regenerates the WSL2 GPU CDI spec at boot, before Docker starts.
[Unit]
Description=Generate the CDI spec for the WSL2 NVIDIA GPU
ConditionPathExists=/dev/dxg
After=local-fs.target
Before=docker.service containerd.service podman.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@BINDIR@/wsl-gpu generate --if-present --quiet

[Install]
WantedBy=multi-user.target
